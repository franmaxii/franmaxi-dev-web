---
interface Props {
    index: string;
    label: string;
    title: string;
    lead?: string;
}

const { index, label, title, lead } = Astro.props;
---

<header class="reveal mb-10 md:mb-14">
    <div class="mb-5 flex items-center gap-4" aria-hidden="true">
        <span class="hud text-volt!">{index}</span>
        <span class="hud" data-scramble>{label}</span>
        <span class="h-px flex-1 bg-line"></span>
    </div>
    <h2 class="display text-[clamp(2.25rem,5.4vw,4.75rem)]">{title}</h2>
    {lead && <p class="lead mt-5 max-w-2xl">{lead}</p>}
</header>
