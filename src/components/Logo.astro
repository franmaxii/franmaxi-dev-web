---
// Logo propio de FranMaxi: símbolo y logotipo dibujados a mano, sin depender de una fuente.
interface Props {
    variant?: 'full' | 'mark';
    class?: string;
}

const { variant = 'full', class: className } = Astro.props;
---

{variant === 'mark' ? (
    <svg class={className} viewBox="0 0 64 64" role="img" aria-label="FranMaxi">
        <polygon points="0,0 50,0 64,14 64,64 14,64 0,50" fill="var(--color-volt)" />
        <path fill="var(--color-void)" d="M10 52V12H28V18.5H16.5V28.5H26V35H16.5V52ZM32 52V12H38.5L44 24L49.5 12H56V52H49.5V26L44 37L38.5 26V52Z" />
    </svg>
) : (
    <svg class={className} viewBox="0 0 326 32" role="img" aria-label="FranMaxi.dev">
        <g fill="none" stroke-width="5" stroke-linejoin="miter" stroke-miterlimit="8">
            <polygon points="0,0 24,0 32,8 32,32 8,32 0,24" fill="var(--color-volt)" stroke="none" />
            <path fill="var(--color-void)" stroke="none" transform="scale(0.5)" d="M10 52V12H28V18.5H16.5V28.5H26V35H16.5V52ZM32 52V12H38.5L44 24L49.5 12H56V52H49.5V26L44 37L38.5 26V52Z" />
            <g stroke="currentColor">
                <path transform="translate(44)" d="M2.5 32V2.5H17M2.5 16H14" />
                <path transform="translate(67)" d="M2.5 32V2.5H17.5V17H2.5M11 17L19 34" />
                <path transform="translate(93)" d="M2.5 32V9L9 2.5H17.5V32M2.5 20H17.5" />
                <path transform="translate(119)" d="M2.5 32V4L18.5 28V0" />
                <path transform="translate(146)" d="M2.5 32V5L13 22L23.5 5V32" />
                <path transform="translate(178)" d="M2.5 32V9L9 2.5H17.5V32M2.5 20H17.5" />
                <path transform="translate(204)" d="M0 -3L20 35M20 -3L0 35" />
                <path transform="translate(230)" d="M2.5 0V32" />
            </g>
            <g stroke="var(--color-volt)">
                <rect x="241" y="27" width="5" height="5" fill="var(--color-volt)" stroke="none" />
                <path transform="translate(252)" d="M2.5 2.5H12L17.5 8V24L12 29.5H2.5Z" />
                <path transform="translate(278)" d="M17 2.5H2.5V29.5H17M2.5 16H14" />
                <path transform="translate(302)" d="M1 -3L11 34L21 -3" />
            </g>
        </g>
    </svg>
)}
