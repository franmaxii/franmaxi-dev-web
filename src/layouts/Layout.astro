---
import '../styles/global.css';

interface Props {
    title: string;
}

const { title } = Astro.props;

// Configuración Comercial de WhatsApp Business - FranMaxi.dev
const whatsappNumber = "5493813580986";

// Mensaje 1: Para cuando tocan el botón flotante general (Consultas)
const whatsappGeneralMessage = encodeURIComponent("Hola FranMaxi, estuve viendo la plataforma y me gustaría hacer una consulta para automatizar mi negocio.");

// Mensaje 2: Para cuando quieren agendar una llamada directamente (Conversión)
const whatsappCallMessage = encodeURIComponent("Hola FranMaxi, quiero acordar una llamada para obtener más información sobre los sistemas y servicios.");
---

<html lang="es" class="dark scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content="Sistemas inteligentes y automatizaciones con n8n y Astro para escalar tu negocio." />
        <title>{title}</title>
    </head>
    <body class="bg-[#050505] text-white font-sans antialiased min-h-screen selection:bg-purple-500 selection:text-white relative overflow-x-hidden">

        <a 
            href="#main-content" 
            class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 z-[100] bg-gradient-to-r from-purple-600 to-blue-600 text-white px-5 py-2.5 rounded-xl font-bold shadow-2xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 focus:ring-offset-[#050505]"
        >
            Saltar al contenido principal
        </a>

        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[500px] bg-purple-600/20 blur-[150px] rounded-full pointer-events-none" aria-hidden="true"></div>

        <header class="relative z-50">
            <nav class="max-w-6xl mx-auto px-6 py-6 flex justify-between items-center" aria-label="Navegación principal">
                <a href="/" class="text-2xl font-bold tracking-tighter focus:outline-none focus:ring-2 focus:ring-purple-500 rounded-lg px-2 -ml-2 transition-shadow relative z-20">
                    Fran<span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-500">Maxi</span>.dev
                </a>
                
                <div class="hidden md:flex gap-8 text-sm font-medium text-gray-400">
                    <a href="/servicios" class="hover:text-white transition-colors focus:outline-none focus:text-white rounded px-2 py-1">Servicios</a>
                    <a href="/#agentes" class="hover:text-white transition-colors focus:outline-none focus:text-white rounded px-2 py-1">Agentes n8n</a>
                    <a href="/#portfolio" class="hover:text-white transition-colors focus:outline-none focus:text-white rounded px-2 py-1">Portfolio</a>
                    <a href="/faq" class="hover:text-white transition-colors focus:outline-none focus:text-white rounded px-2 py-1">Preguntas Frecuentes</a>
                </div>
                
                <div class="flex items-center gap-3 relative z-20">
                    <div class="hidden sm:flex text-gray-400 mr-2">
                        <a href="https://github.com/franmaxii/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-purple-500 rounded p-1" aria-label="GitHub de FranMaxi">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.061.069-.061 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.479C19.138 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
                        </a>
                    </div>
                    
                    <a 
                        href={`https://wa.me/${whatsappNumber}?text=${whatsappCallMessage}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="bg-white text-black px-4 md:px-5 py-2 md:py-2.5 rounded-full text-xs md:text-sm font-bold hover:bg-gray-200 transition-all shadow-[0_0_15px_rgba(255,255,255,0.1)] focus:outline-none focus:ring-4 focus:ring-purple-500/50 active:scale-95"
                    >
                        Agendar <span class="hidden sm:inline">Llamada</span>
                    </a>

                    <button id="mobile-menu-btn" class="md:hidden text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-purple-500 rounded p-1" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú de navegación">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </nav>

            <div id="mobile-menu" class="hidden absolute top-full left-0 w-full bg-[#050505]/95 backdrop-blur-xl border-b border-gray-800 shadow-2xl md:hidden flex-col origin-top animate-fade-in-down z-40">
                <div class="px-6 py-6 flex flex-col gap-5">
                    <a href="/servicios" class="mobile-link text-lg font-semibold text-gray-300 hover:text-white transition-colors">Servicios</a>
                    <a href="/#agentes" class="mobile-link text-lg font-semibold text-gray-300 hover:text-white transition-colors">Agentes n8n</a>
                    <a href="/#portfolio" class="mobile-link text-lg font-semibold text-gray-300 hover:text-white transition-colors">Portfolio</a>
                    <a href="/faq" class="mobile-link text-lg font-semibold text-gray-300 hover:text-white transition-colors">Preguntas Frecuentes</a>
                    <div class="h-px bg-gray-800/50 my-2"></div>
                    <a href="https://github.com/franmaxii/" target="_blank" rel="noopener noreferrer" class="mobile-link flex items-center gap-3 text-sm text-gray-400 hover:text-white transition-colors">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.061.069-.061 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.479C19.138 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
                        Ver Repositorio GitHub
                    </a>
                </div>
            </div>
        </header>

        <slot />

        <footer class="relative z-10 border-t border-gray-900 bg-gradient-to-b from-[#050505] to-[#000]">
            <div class="max-w-4xl mx-auto px-6 py-20 md:py-24 text-center">
                <h2 class="text-3xl font-bold mb-8">¿Listo para evolucionar tu sistema?</h2>
                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
                    
                    <a 
                        href={`https://wa.me/${whatsappNumber}?text=${whatsappCallMessage}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="bg-white text-black px-8 py-3.5 rounded-full text-sm font-bold hover:bg-gray-200 transition-all shadow-[0_0_20px_rgba(255,255,255,0.15)] w-full sm:w-auto focus:outline-none focus:ring-4 focus:ring-purple-500/50 active:scale-95"
                    >
                        Iniciar Proyecto
                    </a>
                    
                    <a href="https://github.com/franmaxii/" target="_blank" rel="noopener noreferrer" class="border border-gray-700 text-white px-8 py-3.5 rounded-full text-sm font-bold hover:bg-gray-800 transition-all w-full sm:w-auto focus:outline-none focus:ring-4 focus:ring-gray-500/50 active:scale-95">
                        Ver mi GitHub
                    </a>
                </div> 
                
                <div class="flex justify-center gap-6 mb-8 text-xs text-gray-500" aria-label="Navegación legal">
                    <a href="/privacidad" class="hover:text-gray-300 transition-colors focus:outline-none focus:underline">Política de Privacidad</a>
                    <span aria-hidden="true">•</span>
                    <a href="/terminos" class="hover:text-gray-300 transition-colors focus:outline-none focus:underline">Términos del Servicio</a>
                    <span aria-hidden="true">•</span>
                    <a href="/servicios" class="hover:text-gray-300 transition-colors focus:outline-none focus:underline">Servicios</a>
                </div>

                <p class="text-xs text-gray-400 font-medium tracking-widest uppercase mb-3 select-none">
                    Código que escala. IA que resuelve.
                </p>
                <p class="text-xs text-gray-600">
                    &copy; 2026 FranMaxi.dev. Infraestructura diseñada en Tucumán.
                </p>
            </div>
        </footer>

        <a 
            href={`https://wa.me/${whatsappNumber}?text=${whatsappGeneralMessage}`}
            target="_blank" 
            rel="noopener noreferrer"
            class="fixed bottom-6 right-6 z-[100] flex items-center justify-center w-14 h-14 bg-[#25D366] hover:bg-[#20bd5a] text-white rounded-full shadow-[0_0_20px_rgba(37,211,102,0.4)] hover:scale-110 hover:shadow-[0_0_30px_rgba(37,211,102,0.6)] transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-[#25D366]/50"
            aria-label="Consultar vía WhatsApp Business"
        >
            <svg class="w-8 h-8 ml-[2px] mt-[1px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span class="absolute top-0 right-0 flex h-3 w-3 -mt-1 -mr-1" aria-hidden="true">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500 border-2 border-[#050505]"></span>
            </span>
        </a>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const btn = document.getElementById('mobile-menu-btn');
                const menu = document.getElementById('mobile-menu');
                const icon = document.getElementById('hamburger-icon');
                const links = document.querySelectorAll('.mobile-link');

                if (btn && menu && icon) {
                    btn.addEventListener('click', () => {
                        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
                        btn.setAttribute('aria-expanded', !isExpanded ? 'true' : 'false');
                        menu.classList.toggle('hidden');
                        menu.classList.toggle('flex');
                        
                        if (!isExpanded) {
                            icon.setAttribute('d', 'M6 18L18 6M6 6l12 12');
                        } else {
                            icon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
                        }
                    });

                    links.forEach(link => {
                        link.addEventListener('click', () => {
                            menu.classList.add('hidden');
                            menu.classList.remove('flex');
                            btn.setAttribute('aria-expanded', 'false');
                            icon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
                        });
                    });
                }
            });
        </script>
    </body>
</html>
