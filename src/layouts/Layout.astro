---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { GITHUB_URL, INSTAGRAM_URL, WA_CALL, WA_GENERAL } from '../lib/contact';

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = 'Productos, automatizaciones y agentes de IA para negocios reales. Código que escala. IA que resuelve.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const navLinks = [
    { href: '/#productos', label: 'Productos', index: '01' },
    { href: '/#servicios', label: 'Servicios', index: '02' },
    { href: '/faq', label: 'FAQ', index: '03' },
];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#05060a" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_AR" />
        <meta property="og:site_name" content="FranMaxi.dev" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta name="twitter:card" content="summary_large_image" />
        <Font cssVariable="--font-oxanium" preload />
        <Font cssVariable="--font-geist" preload />
        <Font cssVariable="--font-jetbrains" />
        <script is:inline>document.documentElement.classList.add('js');</script>
    </head>
    <body class="relative min-h-screen bg-void">
        <a href="#main-content" class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100]">
            Saltar al contenido
        </a>

        <div class="hidden border-b border-line md:block">
            <div class="wrap flex h-8 items-center justify-between">
                <p class="hud flex items-center gap-2 text-[0.66rem]!">
                    <span class="led text-volt" aria-hidden="true"></span> Sistema en línea
                </p>
                <p class="hud flex items-center gap-4 text-[0.66rem]!">
                    <span>Tucumán, AR · 26°49′S 65°13′O</span>
                    <time data-clock class="min-w-[8ch] text-right text-bone">--:--:--</time>
                </p>
            </div>
        </div>

        <header class="sticky top-0 z-50 border-b border-line bg-void/85 backdrop-blur-md">
            <nav class="wrap flex h-16 items-center justify-between gap-6" aria-label="Navegación principal">
                <a href="/" class="text-bone transition-opacity hover:opacity-80" aria-label="FranMaxi.dev, ir al inicio">
                    <Logo class="h-[22px] w-auto md:h-6" />
                </a>

                <div class="hidden items-center gap-8 md:flex">
                    {navLinks.map((link) => (
                        <a href={link.href} class="group font-mono text-xs font-medium uppercase tracking-[0.14em] text-mute transition-colors hover:text-bone">
                            <span class="mr-1.5 text-volt/70 transition-colors group-hover:text-volt" aria-hidden="true">{link.index}</span>{link.label}
                        </a>
                    ))}
                </div>

                <div class="flex items-center gap-3">
                    <a href={WA_CALL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm hidden min-[420px]:inline-flex">
                        <span>Agendar<span class="hidden sm:inline"> llamada</span></span>
                    </a>
                    <button id="mobile-menu-btn" type="button" class="flex h-10 w-10 items-center justify-center text-bone md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menú de navegación">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path id="hamburger-icon" d="M4 7h16M4 12h16M4 17h16" />
                        </svg>
                    </button>
                </div>
            </nav>

            <div id="mobile-menu" class="hidden border-t border-line bg-void md:hidden">
                <div class="wrap flex flex-col gap-1 py-4">
                    {navLinks.map((link) => (
                        <a href={link.href} class="py-3 font-display text-2xl font-bold uppercase text-bone">
                            <span class="mr-3 font-mono text-xs text-volt" aria-hidden="true">{link.index}</span>{link.label}
                        </a>
                    ))}
                    <a href={WA_CALL} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-2 w-full">Agendar llamada <span aria-hidden="true">↗</span></a>
                    <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="hud pt-3 pb-1">Instagram ↗</a>
                    <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="hud pt-1 pb-3">GitHub ↗</a>
                </div>
            </div>
        </header>

        <div id="main-content" tabindex="-1" class="outline-none">
            <slot />
        </div>

        <footer id="contacto" class="relative scroll-mt-16 border-t border-line">
            <div class="wrap py-20 md:py-32">
                <p class="hud mb-6 text-volt!">// Línea abierta</p>
                <h2 class="display text-[clamp(2rem,10.4vw,10.5rem)]">¿Qué<br />construimos<span class="text-volt">?</span></h2>
                <p class="lead mt-8 max-w-xl">Contanos qué querés resolver y vemos por dónde arrancar.</p>
                <div class="mt-10 flex flex-col gap-4 sm:flex-row">
                    <a href={WA_CALL} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Iniciar proyecto <span aria-hidden="true">↗</span></a>
                    <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Instagram <span aria-hidden="true">↗</span></a>
                    <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Ver GitHub <span aria-hidden="true">↗</span></a>
                </div>
            </div>

            <div class="border-t border-line">
                <div class="wrap flex flex-col gap-6 py-8 md:flex-row md:items-center md:justify-between">
                    <p class="hud">&copy; 2026 FranMaxi.dev · Infraestructura diseñada en Tucumán</p>
                    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Navegación legal">
                        <a href="/privacidad" class="hud transition-colors hover:text-bone">Privacidad</a>
                        <a href="/terminos" class="hud transition-colors hover:text-bone">Términos</a>
                        <a href="/servicios" class="hud transition-colors hover:text-bone">Servicios</a>
                    </nav>
                </div>
            </div>
        </footer>

        <a href={WA_GENERAL} target="_blank" rel="noopener noreferrer" class="cut fixed bottom-5 right-5 z-[60] flex h-14 w-14 items-center justify-center text-void transition-transform hover:-translate-y-0.5 [--cut:12px] [--edge:var(--color-volt)] [--fill:var(--color-volt)]" aria-label="Escribinos por WhatsApp">
            <svg class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.746.953 3.71 1.454 5.709 1.455h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
        </a>

        <script>
            import '../scripts/ui';
        </script>
    </body>
</html>
