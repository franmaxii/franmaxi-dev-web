---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { waLink } from '../lib/contact';

const services = [
    {
        index: '01',
        title: 'Desarrollo web y plataformas',
        text: 'Creamos la identidad digital de tu negocio con arquitecturas modernas como Astro y Tailwind: sitios corporativos rápidos, landings de conversión y plataformas SaaS pensadas para crecer.',
        items: ['Optimización SEO técnica', 'Experiencia de usuario cuidada', 'Diseño adaptado a cada pantalla'],
        cta: 'Cotizar desarrollo',
        message: 'Hola FranMaxi, quiero cotizar un desarrollo web.',
    },
    {
        index: '02',
        title: 'Automatización e integración de IA',
        text: 'Conectamos tus herramientas, como CRMs, bases de datos y redes, con orquestadores como n8n y modelos de IA. Eliminamos tareas repetitivas y creamos agentes de atención para que tu operación crezca sin sumar costos fijos.',
        items: ['Flujos de trabajo con n8n', 'Integración de agentes y modelos de IA', 'Infraestructuras conectadas con PocketBase y APIs'],
        cta: 'Automatizar mi negocio',
        message: 'Hola FranMaxi, quiero automatizar procesos de mi negocio.',
    },
];
---

<Layout title="Servicios | FranMaxi.dev" description="Desarrollo web, automatización con n8n e integración de IA a medida.">
    <main class="wrap py-14 md:py-24">
        <PageHead label="Servicios" title="Ingeniería digital a medida" lead="Combinamos diseño web cuidado con automatización inteligente." />

        <div class="grid gap-6 lg:grid-cols-2">
            {services.map((service) => (
                <article class="cut cut-link flex flex-col justify-between p-6 md:p-10">
                    <div>
                        <p class="hud text-volt!" aria-hidden="true">{service.index}</p>
                        <h2 class="display mt-6 text-[clamp(1.75rem,3vw,2.75rem)]">{service.title}</h2>
                        <p class="mt-5 leading-relaxed text-mute">{service.text}</p>
                        <ul class="mt-6 space-y-2 font-mono text-sm text-bone">
                            {service.items.map((item) => (
                                <li><span class="mr-2 text-volt" aria-hidden="true">+</span>{item}</li>
                            ))}
                        </ul>
                    </div>
                    <a href={waLink(service.message)} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-10 w-fit">{service.cta} <span aria-hidden="true">↗</span></a>
                </article>
            ))}
        </div>
    </main>
</Layout>
