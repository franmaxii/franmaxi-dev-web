---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import { WHATSAPP_NUMBER, waLink } from '../lib/contact';

const chips = ['Bot de WhatsApp', 'Agente de IA', 'Automatizar ventas', 'Sistema a medida'];
const stack = ['Astro', 'n8n', 'Cloudflare', 'Docker', 'PocketBase'];
const tape = ['Código que escala', 'IA que resuelve', ...stack];

const chatFeatures = ['Una página con tus textos y secciones', 'Botón de contacto por WhatsApp', 'Cambios por chat cuando los necesites'];

const changasFeatures = ['Portfolio con diseño a partir de tu obra', 'Proyectos con créditos entre artistas', 'Videos desde YouTube'];

const services = [
    {
        kind: 'Flujos',
        title: 'Automatización n8n',
        text: 'Conectamos WhatsApp, CRMs y correo en flujos de trabajo que te sacan de encima las tareas manuales.',
    },
    {
        id: 'agentes',
        kind: 'Agentes',
        title: 'Agentes de IA',
        text: 'Asistentes con memoria y contexto, preparados con los datos de tu empresa, para atención al cliente o uso interno.',
    },
    {
        kind: 'Web',
        title: 'Web en el edge',
        text: 'Sitios rápidos con Astro, desplegados en la red global de Cloudflare.',
    },
];

const examples = [
    {
        title: 'Agente de ventas inmobiliario',
        tags: ['OpenAI', 'WhatsApp'],
        text: 'Bot conectado al catálogo de propiedades. Califica consultas las 24 horas, agenda visitas en el calendario y guarda los datos en el CRM.',
    },
    {
        title: 'Onboarding automático',
        tags: ['n8n', 'APIs'],
        text: 'Flujo que detecta un pago, crea la cuenta del usuario, envía el correo de bienvenida y avisa al equipo por Slack.',
    },
];
---

<Layout title="FranMaxi.dev | Productos, automatización e IA">
    <main>
        <section class="relative isolate flex min-h-[min(calc(100svh-6rem),56rem)] flex-col overflow-hidden" aria-labelledby="hero-title">
            <canvas data-terrain class="absolute inset-x-0 bottom-0 -z-10 h-[50%] w-full [mask-image:linear-gradient(to_bottom,transparent,black_26%)] md:h-[56%]" aria-hidden="true"></canvas>

            <div class="wrap pb-[34svh] pt-12 md:pb-[30svh] md:pt-16">
                <p class="hud mb-6"><span class="text-volt">//</span> Software, automatización e IA</p>
                <h1 id="hero-title" class="display text-[clamp(2.75rem,7.7vw,7.75rem)]">
                    <span class="block">Código que escala.</span>
                    <span class="glitch block text-volt [text-shadow:0_0_42px_rgb(200_255_46/0.35)]" data-text="IA que resuelve.">IA que resuelve.</span>
                </h1>

                <div class="mt-10 grid grid-cols-[minmax(0,1fr)] items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,33rem)] lg:gap-16">
                    <div>
                        <p class="lead max-w-xl">Productos, automatizaciones y agentes de IA para negocios reales. Hechos en Tucumán, listos para cualquier lado.</p>
                        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
                            <a href="#productos" class="btn btn-primary">Ver productos <span aria-hidden="true">↓</span></a>
                            <a href="/servicios" class="btn btn-ghost">Servicios a medida</a>
                        </div>
                    </div>

                    <form data-brief action={`https://wa.me/${WHATSAPP_NUMBER}`} method="get" target="_blank" class="cut p-5 md:p-6 [--fill:rgb(11_13_20/0.94)]">
                        <div class="mb-4 flex items-center justify-between gap-4">
                            <label for="brief-input" class="font-display text-lg font-bold">¿Qué querés construir?</label>
                            <span class="hud hidden shrink-0 text-[0.62rem]! sm:inline" aria-hidden="true">Nuevo proyecto</span>
                        </div>
                        <div class="flex items-stretch gap-2 border border-line bg-void focus-within:border-volt">
                            <span class="flex items-center pl-3 font-mono text-volt" aria-hidden="true">&gt;</span>
                            <input id="brief-input" name="text" type="text" required autocomplete="off" placeholder="Ej: bot de ventas" class="min-w-0 flex-1 bg-transparent py-3 pr-2 font-mono text-sm text-bone outline-none placeholder:text-mute/80" />
                            <button type="submit" class="m-1 shrink-0 bg-volt px-4 font-mono text-xs font-bold uppercase tracking-wider text-void transition-colors hover:bg-bone">
                                Enviar <span aria-hidden="true">↗</span>
                            </button>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            {chips.map((chip) => (
                                <button type="button" data-chip={chip} class="border border-line px-2.5 py-1.5 font-mono text-[0.7rem] text-mute transition-colors hover:border-volt hover:text-volt">{chip}</button>
                            ))}
                        </div>
                        <p class="mt-3 text-xs text-mute">Se abre WhatsApp con tu mensaje listo para enviar.</p>
                    </form>
                </div>
            </div>
        </section>

        <div class="relative z-10 -my-1 -rotate-1 overflow-hidden bg-volt py-2.5 text-void">
            <ul class="sr-only" aria-label="Tecnología que usamos">
                {stack.map((name) => <li>{name}</li>)}
            </ul>
            <div class="flex w-max animate-tape" aria-hidden="true">
                {[0, 1].map(() => (
                    <div class="flex shrink-0">
                        {[...tape, ...tape, ...tape].map((word) => (
                            <span class="flex items-center gap-5 pr-5 font-display text-lg font-extrabold uppercase">{word}<span class="font-mono text-sm">//</span></span>
                        ))}
                    </div>
                ))}
            </div>
        </div>

        <section id="productos" class="wrap scroll-mt-24 py-24 md:py-36">
            <span id="portfolio"></span>
            <SectionHead index="01" label="Productos" title="Software propio" lead="Productos que hacemos nosotros, cada uno para resolver un problema concreto." />

            <div class="grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-12">
                <article class="cut reveal grid grid-cols-[minmax(0,1fr)] gap-8 p-6 md:grid-cols-2 md:p-10 lg:col-span-12 [--edge:rgb(255_45_120/0.55)]">
                    <div class="flex flex-col">
                        <p class="tag w-fit text-hot"><span class="led" aria-hidden="true"></span> En construcción</p>
                        <h3 class="display mt-6 text-[clamp(1.9rem,4.6vw,4rem)]">
                            <span class="block">chat.</span>
                            <span class="block">franmaxi<span class="text-hot">.lol</span></span>
                        </h3>
                        <p class="lead mt-4">Escribí qué necesitás y el chat arma tu página web sencilla, sin tocar código.</p>
                        <ul class="mt-6 space-y-2 font-mono text-sm text-bone">
                            {chatFeatures.map((feature) => (
                                <li><span class="mr-2 text-hot" aria-hidden="true">+</span>{feature}</li>
                            ))}
                        </ul>
                        <a href={waLink('Hola FranMaxi, quiero probar chat.franmaxi.lol cuando esté listo.')} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-8 w-fit">Quiero probarlo <span aria-hidden="true">↗</span></a>
                    </div>

                    <div class="self-center border border-line bg-void p-4 md:p-5" aria-hidden="true">
                        <div class="ml-auto max-w-[85%] bg-panel-2 px-3 py-2.5 text-sm text-bone">Haceme una web para mi taller de bicis en Tucumán.</div>
                        <div class="mt-3 max-w-[85%] border-l-2 border-hot px-3 py-1 text-sm text-mute">Listo. Mirá cómo quedó tu página:</div>
                        <div class="mt-4 border border-line p-3 md:p-4">
                            <div class="flex items-center justify-between gap-3 border-b border-line pb-3">
                                <span class="hud text-bone!">Taller La Cadena</span>
                                <span class="hud shrink-0 text-hot! text-[0.62rem]!">Vista previa</span>
                            </div>
                            <div class="mt-3 grid grid-cols-3 gap-2 text-center font-mono text-[0.68rem] text-bone sm:text-xs">
                                <span class="border border-line py-2">Servicios</span>
                                <span class="border border-line py-2">Horarios</span>
                                <span class="border border-line py-2">Ubicación</span>
                            </div>
                            <div class="mt-4 bg-volt py-2.5 text-center font-mono text-xs font-bold uppercase tracking-wider text-void">Escribir por WhatsApp</div>
                        </div>
                    </div>
                </article>

                <article class="cut reveal grid grid-cols-[minmax(0,1fr)] gap-8 p-6 md:grid-cols-2 md:p-10 lg:col-span-12 [--edge:rgb(255_45_120/0.55)]">
                    <div class="flex flex-col">
                        <p class="tag w-fit text-hot"><span class="led" aria-hidden="true"></span> En construcción</p>
                        <h3 class="display mt-6 text-[clamp(2.25rem,4.6vw,4rem)]">changas<span class="text-hot">.cv</span></h3>
                        <p class="lead mt-4">La red de la escena artística y hippie. Contás qué hacés, subís tu obra y la IA diseña tu portfolio.</p>
                        <ul class="mt-6 space-y-2 font-mono text-sm text-bone">
                            {changasFeatures.map((feature) => (
                                <li><span class="mr-2 text-hot" aria-hidden="true">+</span>{feature}</li>
                            ))}
                        </ul>
                        <a href={waLink('Hola FranMaxi, soy parte de la escena y quiero sumarme a changas.cv.')} target="_blank" rel="noopener noreferrer" class="btn btn-ghost mt-8 w-fit">Quiero sumarme <span aria-hidden="true">↗</span></a>
                    </div>

                    <div class="self-center border border-line bg-void p-4 md:p-5" aria-hidden="true">
                        <div class="ml-auto max-w-[85%] bg-panel-2 px-3 py-2.5 text-sm text-bone">Pinto murales y toco en una banda.</div>
                        <div class="mt-3 max-w-[85%] border-l-2 border-hot px-3 py-1 text-sm text-mute">Pasame fotos de tus obras y el link de YouTube de tu último show.</div>
                        <div class="mt-4 flex items-center justify-between gap-3 border border-hot/60 px-3 py-2.5">
                            <span class="truncate font-mono text-sm text-bone">luna.changas.cv</span>
                            <span class="hud shrink-0 text-hot! text-[0.62rem]!">Vista previa</span>
                        </div>
                    </div>
                </article>
            </div>
        </section>

        <section id="servicios" class="scroll-mt-24 border-t border-line bg-panel/40">
            <div class="wrap py-24 md:py-36">
                <SectionHead index="02" label="Servicios" title="Sistemas a medida" lead="Si ningún producto te alcanza, lo armamos para tu operación." />

                <div class="grid gap-6 md:grid-cols-3">
                    {services.map((service) => (
                        <article id={service.id} class="cut reveal scroll-mt-24 p-6 md:p-8">
                            <p class="hud text-volt!" aria-hidden="true">{service.kind}</p>
                            <h3 class="mt-8 font-display text-2xl font-bold uppercase">{service.title}</h3>
                            <p class="mt-3 leading-relaxed text-mute">{service.text}</p>
                        </article>
                    ))}
                </div>

                <h3 class="hud mb-4 mt-16 text-bone!">Sistemas que ya armamos</h3>
                <ul class="border-t border-line">
                    {examples.map((example) => (
                        <li class="reveal grid gap-3 border-b border-line py-6 md:grid-cols-[minmax(0,1fr)_minmax(0,1.8fr)_11rem] md:items-center md:gap-8">
                            <h4 class="font-display text-xl font-bold">{example.title}</h4>
                            <p class="text-mute">{example.text}</p>
                            <p class="flex gap-2 md:justify-end">
                                {example.tags.map((tag) => <span class="tag text-ice">{tag}</span>)}
                            </p>
                        </li>
                    ))}
                </ul>

                <a href="/servicios" class="btn btn-ghost mt-10">Ver todos los servicios <span aria-hidden="true">→</span></a>
            </div>
        </section>
    </main>

    <script>
        import '../scripts/terrain';
    </script>
</Layout>
