---
// MUESTRA / MOCKUP de sitio para IMPEROS — página de demostración para el presupuesto.
// Contenido ficticio. Página autónoma, sin el Layout del sitio. noindex.

const direccion = {
  calle: "Combate de Las Piedras 260, bloque 2, departamento 2C",
  ciudad: "T4000 San Miguel de Tucumán, Tucumán",
};

const categorias = ["Todos", "Gala", "Cóctel", "Civil", "Novia"];

const vestidos = [
  { nombre: "Aurora",   cat: "Gala",   color: "Verde esmeralda",  hex: "#1f5c47", talles: "36 – 42", precio: "45.000" },
  { nombre: "Valentina",cat: "Novia",  color: "Marfil",           hex: "#efe6d2", talles: "38 – 44", precio: "120.000" },
  { nombre: "Bruma",    cat: "Cóctel", color: "Negro",            hex: "#2b2b2b", talles: "34 – 40", precio: "32.000" },
  { nombre: "Salinas",  cat: "Gala",   color: "Borgoña",          hex: "#6d1f34", talles: "36 – 42", precio: "48.000" },
  { nombre: "Lumière",  cat: "Gala",   color: "Dorado champán",   hex: "#cbaa6b", talles: "36 – 40", precio: "52.000" },
  { nombre: "Junín",    cat: "Civil",  color: "Blanco hueso",     hex: "#eae6d9", talles: "36 – 44", precio: "60.000" },
  { nombre: "Duna",     cat: "Cóctel", color: "Nude",             hex: "#d8b79c", talles: "34 – 40", precio: "30.000" },
  { nombre: "Celeste",  cat: "Gala",   color: "Azul noche",       hex: "#24304f", talles: "38 – 42", precio: "46.000" },
  { nombre: "Amapola",  cat: "Cóctel", color: "Rojo",             hex: "#9e2b2b", talles: "36 – 42", precio: "34.000" },
  { nombre: "Nieve",    cat: "Novia",  color: "Blanco",           hex: "#f2efe7", talles: "38 – 44", precio: "135.000" },
  { nombre: "Terral",   cat: "Gala",   color: "Terracota",        hex: "#b5623c", talles: "36 – 40", precio: "44.000" },
  { nombre: "Orquídea", cat: "Gala",   color: "Violeta",          hex: "#6a4a86", talles: "34 – 40", precio: "47.000" },
];

const waDemo = "https://wa.me/5493810000000";
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <title>Muestra IMPEROS | FranMaxi.dev</title>
  <meta name="description" content="Muestra de demostración de un sitio de alquiler de vestidos para IMPEROS. Contenido ficticio, diseñado por FranMaxi.dev." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />

  <style is:global>
    :root {
      --bg: #f5f3ec;
      --surface: #fffdf7;
      --surface-2: #ece7d8;
      --border: #ddd6c4;
      --text: #1c241f;
      --muted: #5c665e;
      --faint: #8a9088;
      --accent: #234b3b;
      --accent-ink: #17372a;
      --brass: #9a7b3f;
      /* marca IMPEROS — constante en ambos temas */
      --imperos-green: #1f3d2e;
      --imperos-cream: #f0e6cf;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #0f1613;
        --surface: #17201b;
        --surface-2: #1f2a23;
        --border: #29332c;
        --text: #eef0ea;
        --muted: #9aa39c;
        --faint: #6d776f;
        --accent: #83b89e;
        --accent-ink: #a3ceb8;
        --brass: #cba871;
      }
    }
    :root[data-theme="dark"] {
      --bg: #0f1613;
      --surface: #17201b;
      --surface-2: #1f2a23;
      --border: #29332c;
      --text: #eef0ea;
      --muted: #9aa39c;
      --faint: #6d776f;
      --accent: #83b89e;
      --accent-ink: #a3ceb8;
      --brass: #cba871;
    }

    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    img { max-width: 100%; }
    html { -webkit-text-size-adjust: 100%; }
    @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3 { font-family: "Fraunces", Georgia, "Times New Roman", serif; font-optical-sizing: auto; text-wrap: balance; margin: 0; }
    a { color: inherit; }

    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 2.5rem); }

    /* ribbon */
    .ribbon {
      background: var(--imperos-green);
      color: var(--imperos-cream);
      font-size: .74rem;
      letter-spacing: .06em;
      text-align: center;
      padding: .5rem 1rem;
      text-transform: uppercase;
    }
    .ribbon b { color: #fff; font-weight: 600; }

    /* nav */
    .nav { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); }
    .nav .wrap { display: flex; align-items: center; justify-content: space-between; height: 68px; }
    .brand { display: flex; align-items: center; gap: .7rem; text-decoration: none; }
    .mark { width: 34px; height: 42px; background: var(--imperos-green); display: grid; place-items: center; position: relative; border-radius: 2px; flex-shrink: 0; }
    .mark::before { content: ""; position: absolute; inset: 3px; border: 1px solid color-mix(in srgb, var(--imperos-cream) 55%, transparent); }
    .mark span { font-family: "Fraunces", serif; color: var(--imperos-cream); font-size: 1.15rem; font-weight: 500; line-height: 1; }
    .brand strong { font-family: "Fraunces", serif; font-weight: 500; font-size: 1.15rem; letter-spacing: .18em; }
    .nav-links { display: flex; align-items: center; gap: 1.6rem; }
    .nav-links a { text-decoration: none; font-size: .9rem; color: var(--muted); }
    .nav-links a:hover { color: var(--text); }
    .nav-links a.btn { color: var(--imperos-cream); }
    @media (max-width: 720px) { .nav-links a:not(.btn) { display: none; } }

    .btn {
      display: inline-block; text-decoration: none;
      background: var(--accent); color: var(--imperos-cream);
      font-size: .9rem; font-weight: 500;
      padding: .6rem 1.15rem; border-radius: 999px; border: 0;
      cursor: pointer;
    }
    .btn-ghost {
      display: inline-block; text-decoration: none;
      border: 1px solid var(--border); color: var(--text);
      font-size: .9rem; font-weight: 500;
      padding: .6rem 1.15rem; border-radius: 999px; background: transparent;
    }

    /* hero */
    .hero { padding: clamp(3rem, 9vw, 6rem) 0 clamp(2.5rem, 6vw, 4rem); border-bottom: 1px solid var(--border); }
    .eyebrow { font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--brass); margin-bottom: 1rem; }
    .hero h1 { font-size: clamp(2.3rem, 6vw, 4rem); font-weight: 500; line-height: 1.06; letter-spacing: -.01em; max-width: 15ch; }
    .hero p { color: var(--muted); font-size: clamp(1rem, 2.2vw, 1.2rem); max-width: 52ch; margin: 1.3rem 0 2rem; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: .8rem; }
    .hero-facts { margin-top: 2.6rem; display: flex; flex-wrap: wrap; gap: .5rem 1.4rem; font-size: .85rem; color: var(--faint); }
    .hero-facts span { display: inline-flex; align-items: center; gap: .45rem; }
    .hero-facts span::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--brass); }

    /* sections */
    section.blk { padding: clamp(3rem, 8vw, 5.5rem) 0; }
    .head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }
    .head h2 { font-size: clamp(1.7rem, 4vw, 2.4rem); font-weight: 500; }
    .head p { margin: .4rem 0 0; color: var(--muted); font-size: .95rem; }

    /* filters */
    .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.8rem; }
    .filters button {
      font: inherit; font-size: .85rem;
      padding: .4rem .95rem; border-radius: 999px;
      border: 1px solid var(--border); background: transparent; color: var(--muted);
      cursor: pointer;
    }
    .filters button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--imperos-cream); }

    /* en tema oscuro el acento es claro → texto oscuro sobre los botones */
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .btn,
      :root:not([data-theme="light"]) .nav-links a.btn,
      :root:not([data-theme="light"]) .filters button[aria-pressed="true"] { color: #0f1613; }
    }
    :root[data-theme="dark"] .btn,
    :root[data-theme="dark"] .nav-links a.btn,
    :root[data-theme="dark"] .filters button[aria-pressed="true"] { color: #0f1613; }
    .band .btn { background: var(--imperos-cream); color: var(--imperos-green); }

    /* catalog grid */
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.4rem; }
    .card { border: 1px solid var(--border); border-radius: 12px; overflow: hidden; background: var(--surface); display: flex; flex-direction: column; }
    .card .ph {
      aspect-ratio: 3 / 4;
      background:
        linear-gradient(165deg, color-mix(in srgb, var(--c) 26%, var(--surface)), color-mix(in srgb, var(--c) 6%, var(--surface)));
      display: grid; place-items: center; position: relative;
    }
    .card .ph::after { content: ""; position: absolute; inset: 10px; border: 1px solid color-mix(in srgb, var(--imperos-cream) 30%, transparent); }
    .card .ph svg { width: 44%; height: 60%; }
    .card .ph svg path {
      fill: color-mix(in srgb, var(--c) 32%, var(--surface));
      stroke: color-mix(in srgb, var(--imperos-cream) 55%, transparent);
      stroke-width: 1.2;
    }
    .card .body { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; gap: .3rem; flex: 1; }
    .card .cat { font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; color: var(--brass); }
    .card h3 { font-size: 1.2rem; font-weight: 500; }
    .card .meta { font-size: .82rem; color: var(--muted); display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .swatch { width: 11px; height: 11px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--text) 20%, transparent); background: var(--c); display: inline-block; }
    .card .price { font-weight: 600; margin-top: .2rem; }
    .card .price small { font-weight: 400; color: var(--muted); }
    .card .estado { font-size: .78rem; color: var(--accent-ink); display: inline-flex; align-items: center; gap: .4rem; margin: .1rem 0 .7rem; }
    .card .estado::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #3f9b6d; }
    .card .btn-ghost { margin-top: auto; text-align: center; }

    .note { font-size: .8rem; color: var(--faint); margin-top: 1.4rem; }

    /* steps */
    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.4rem; counter-reset: s; }
    .step { border-top: 2px solid var(--brass); padding-top: 1rem; }
    .step .n { counter-increment: s; font-family: "Fraunces", serif; font-size: 1.5rem; color: var(--brass); }
    .step .n::before { content: counter(s); }
    .step h3 { font-size: 1.15rem; font-weight: 500; margin: .3rem 0 .4rem; }
    .step p { margin: 0; color: var(--muted); font-size: .92rem; }

    /* showroom */
    .showroom { display: grid; grid-template-columns: 1fr 1fr; gap: 1.6rem; align-items: stretch; }
    @media (max-width: 780px) { .showroom { grid-template-columns: 1fr; } }
    .sr-card { border: 1px solid var(--border); border-radius: 12px; background: var(--surface); padding: 1.6rem 1.7rem; }
    .sr-card h3 { font-size: 1.3rem; font-weight: 500; margin-bottom: .8rem; }
    .sr-card p { margin: .2rem 0; }
    .sr-card .lbl { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); margin-top: 1.1rem; }
    .map {
      border: 1px solid var(--border); border-radius: 12px; position: relative; overflow: hidden; min-height: 240px;
      background:
        repeating-linear-gradient(0deg, transparent 0 26px, color-mix(in srgb, var(--text) 6%, transparent) 26px 27px),
        repeating-linear-gradient(90deg, transparent 0 26px, color-mix(in srgb, var(--text) 6%, transparent) 26px 27px),
        var(--surface-2);
    }
    .map .road { position: absolute; background: color-mix(in srgb, var(--text) 12%, transparent); }
    .map .r1 { left: 0; right: 0; top: 58%; height: 10px; }
    .map .r2 { top: 0; bottom: 0; left: 38%; width: 10px; }
    .map .pin { position: absolute; left: 38%; top: 58%; transform: translate(-50%, -100%); color: var(--accent); }
    .map .pin svg { width: 30px; height: 30px; display: block; filter: drop-shadow(0 2px 3px rgba(0,0,0,.3)); }
    .map .tag { position: absolute; left: 12px; bottom: 12px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; font-size: .78rem; padding: .35rem .6rem; color: var(--muted); }

    /* cta band */
    .band { background: var(--imperos-green); color: var(--imperos-cream); border-radius: 16px; padding: clamp(2rem, 6vw, 3.4rem); text-align: center; }
    .band h2 { font-size: clamp(1.6rem, 4vw, 2.3rem); font-weight: 500; }
    .band p { color: color-mix(in srgb, var(--imperos-cream) 78%, transparent); margin: .7rem auto 1.6rem; max-width: 44ch; }
    .band .btn { background: var(--imperos-cream); color: var(--imperos-green); }

    /* footer */
    footer.site { border-top: 1px solid var(--border); padding: 2.4rem 0 3rem; margin-top: 1rem; }
    footer.site .wrap { display: flex; flex-wrap: wrap; gap: 1rem 2rem; justify-content: space-between; font-size: .82rem; color: var(--faint); }
    footer.site a { color: var(--muted); }
    footer.site .disc { max-width: 46ch; }
  </style>
</head>
<body>

  <div class="ribbon">Muestra de demostración · modelos, precios y datos de ejemplo · diseño <b>FranMaxi.dev</b></div>

  <header class="nav">
    <div class="wrap">
      <a class="brand" href="#top">
        <span class="mark"><span>I</span></span>
        <strong>IMPEROS</strong>
      </a>
      <nav class="nav-links">
        <a href="#catalogo">Catálogo</a>
        <a href="#como">Cómo funciona</a>
        <a href="#showroom">Showroom</a>
        <a class="btn" href="#reservar">Reservar cita</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">Alquiler de vestidos de fiesta · San Miguel de Tucumán</p>
        <h1>El vestido de tu próxima fiesta, sin comprarlo</h1>
        <p>Amplia variedad de estilos y talles. Reservá tu cita de prueba en el showroom, dejá la seña online y llevátelo el día de tu evento.</p>
        <div class="hero-cta">
          <a class="btn" href="#catalogo">Ver catálogo</a>
          <a class="btn-ghost" href="#reservar">Reservar cita de prueba</a>
        </div>
        <div class="hero-facts">
          <span>+120 modelos</span>
          <span>Talles 34 a 46</span>
          <span>Gala · Cóctel · Civil · Novia</span>
          <span>Seña online</span>
        </div>
      </div>
    </section>

    <section class="blk" id="catalogo">
      <div class="wrap">
        <div class="head">
          <div>
            <h2>Catálogo</h2>
            <p>Elegí un modelo y reservá la cita para probártelo.</p>
          </div>
        </div>

        <div class="filters" role="group" aria-label="Filtrar por categoría">
          {categorias.map((c, i) => (
            <button type="button" data-filter={c} aria-pressed={i === 0 ? "true" : "false"}>{c}</button>
          ))}
        </div>

        <div class="grid" id="catgrid">
          {vestidos.map((v) => (
            <article class="card" data-cat={v.cat} style={`--c:${v.hex}`}>
              <div class="ph">
                <svg viewBox="0 0 60 90" aria-hidden="true">
                  <path d="M20 9 Q30 3 40 9 L37 21 Q34 27 33 33 Q47 56 50 82 L10 82 Q13 56 27 33 Q26 27 23 21 Z" />
                </svg>
              </div>
              <div class="body">
                <span class="cat">{v.cat}</span>
                <h3>{v.nombre}</h3>
                <span class="meta"><span class="swatch"></span>{v.color} · Talles {v.talles}</span>
                <span class="price">${v.precio} <small>/ 3 días</small></span>
                <span class="estado">Disponible</span>
                <a class="btn-ghost" href="#reservar">Reservar este modelo</a>
              </div>
            </article>
          ))}
        </div>
        <p class="note">Modelos, colores y precios de ejemplo para esta muestra. En el sitio real, el catálogo se carga solo desde las carpetas de Google Drive de IMPEROS.</p>
      </div>
    </section>

    <section class="blk" id="como" style="background: var(--surface-2);">
      <div class="wrap">
        <div class="head"><div><h2>Cómo funciona</h2></div></div>
        <div class="steps">
          <div class="step">
            <div class="n"></div>
            <h3>Elegí tu vestido</h3>
            <p>Navegá el catálogo por categoría, color y talle. Cuando encuentres el indicado, tocá «Reservar este modelo».</p>
          </div>
          <div class="step">
            <div class="n"></div>
            <h3>Reservá la cita y la seña</h3>
            <p>Elegís día y horario para probártelo en el showroom y dejás la seña online. El turno queda confirmado al instante.</p>
          </div>
          <div class="step">
            <div class="n"></div>
            <h3>Retirá y disfrutá</h3>
            <p>Te llega un WhatsApp con la confirmación y los recordatorios de retiro y devolución. Sin trámites el día del evento.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="blk" id="showroom">
      <div class="wrap">
        <div class="head"><div><h2>Showroom</h2><p>Atención con cita previa.</p></div></div>
        <div class="showroom">
          <div class="sr-card">
            <h3>Dónde estamos</h3>
            <p>{direccion.calle}</p>
            <p>{direccion.ciudad}</p>
            <p class="lbl">Horarios</p>
            <p>Lunes a viernes · 10 a 19 h</p>
            <p>Sábados · 10 a 14 h</p>
            <p class="lbl">Turnos</p>
            <p>Las pruebas son con cita previa reservada desde el catálogo.</p>
            <p style="margin-top:1.3rem"><a class="btn" href={waDemo}>Escribir por WhatsApp</a></p>
          </div>
          <div class="map" role="img" aria-label={`Ubicación aproximada: ${direccion.calle}, ${direccion.ciudad}`}>
            <div class="road r1"></div>
            <div class="road r2"></div>
            <div class="pin">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C7.6 2 4 5.6 4 10c0 5.4 7 12 8 12s8-6.6 8-12c0-4.4-3.6-8-8-8zm0 11a3 3 0 110-6 3 3 0 010 6z"/></svg>
            </div>
            <span class="tag">Combate de Las Piedras 260 · bloque 2</span>
          </div>
        </div>
      </div>
    </section>

    <section class="blk" id="reservar">
      <div class="wrap">
        <div class="band">
          <h2>¿Lista para elegir tu vestido?</h2>
          <p>Reservá tu cita de prueba en el showroom. Te confirmamos el turno y coordinamos todo por WhatsApp.</p>
          <a class="btn" href={waDemo}>Reservar por WhatsApp</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site">
    <div class="wrap">
      <div>
        <strong style="font-family:'Fraunces',serif;letter-spacing:.16em;">IMPEROS</strong><br />
        {direccion.calle}<br />
        {direccion.ciudad}
      </div>
      <div class="disc">
        Muestra sin fines comerciales. Marca, modelos, precios, horarios y número de contacto son de ejemplo.
        Diseñado por <a href="https://franmaxi.dev">FranMaxi.dev</a> como parte de un presupuesto.
      </div>
    </div>
  </footer>

  <script>
    const btns = document.querySelectorAll('.filters button');
    const cards = document.querySelectorAll('#catgrid .card');
    btns.forEach((b) => {
      b.addEventListener('click', () => {
        btns.forEach((x) => x.setAttribute('aria-pressed', 'false'));
        b.setAttribute('aria-pressed', 'true');
        const f = b.dataset.filter;
        cards.forEach((c) => {
          c.hidden = !(f === 'Todos' || c.dataset.cat === f);
        });
      });
    });
  </script>
</body>
</html>
